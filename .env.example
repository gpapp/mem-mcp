# Neo4j Configuration
MEM_NEO4J_PASSWORD=your_secure_password_here
NEO_PASS=your_secure_password_here

# Vector Store (Qdrant)
MEM_QDRANT_URL=http://qdrant:6333

# LLM / Embedder (Ollama)
MEM_LLM_URL=http://ollama:11434
MEM_EMBEDDER_URL=http://ollama:11434
MEM_EMBEDDER_MODEL=nomic-embed-text
# Two separate questions: is it ON the GPU, and is it GOOD ENOUGH.
#
# 1. On the GPU? Ollama only uses the card if the service can see the device.
#    `docker exec ollama ls /dev/nvidia*` must list /dev/nvidia0, and
#    `docker exec ollama ollama ps` must say "100% GPU". If it says 100% CPU
#    you are measuring CPU inference on 15 GiB of RAM with 7.1 GiB of swap
#    already used -- the variance is enormous (the same 15-word prompt
#    measured 4.3s and 88.6s) and no model size will fix that.
#
# 2. Good enough? Registry sizes on a 4 GB card shared with ASR (1.25 GB):
#      granite3.3:2b          2.34 GB -- stays 100% GPU
#      nemotron-3-nano:4b     2.63 GB used of 3.3 GB -- 79.7% GPU, spills to
#                                       system RAM, so its cold calls are slow
#      qwen3.5:2b-q4_K_M     1.95 GB -- stays 100% GPU
#      gemma3:4b-it-q4_K_M   3.34 GB -- 49%/51% CPU/GPU, pays a load per call
#      gemma4:e2b            7.16 GB -- never resident
#
#    Two models on one 4 GB card cannot both stay resident (2.34 + 2.63 GB, plus
#    ASR's 1.25 GB). Running extraction and judgement on different models means a
#    role change evicts the other model. That is the intended trade: the cheap
#    high-volume role re-loads fast, and the expensive one stays warm across a
#    reclassify. OLLAMA_KEEP_ALIVE=30m covers the common case where one role
#    dominates a session.
#    A 2b model is not merely faster: asked to classify scope it completes
#    fields rather than reasoning about them. On the same diary entry
#    qwen3.5:2b-q4_K_M answered {"client": "EPAM", "context": "PPC"};
#    gemma3:4b-it-q4_K_M answered the correct verdict in 5 consecutive runs,
#    and also fixed a search-rewrite hallucination. Correctness wins over
#    residency here; budget the extra load time instead (a full reclassify is
#    a multi-minute job under MEM_LLM_TIMEOUT=300).
#
# There are four chat roles and one knob cannot be right for all of them.
# Extraction is high-volume and mechanical (diary keywords, people names, search
# rewriting): it wants the fastest model that will not invent terms. Judgement is
# low-volume and consequential (scope classification, merge-draft writing,
# duplicate-cluster adjudication): it wants the model that does not guess.
#
# Measured on this host, same prompts, against the real vault:
#
#   role              granite3.3:2b              nemotron-3-nano:4b
#   keywords          99.0% prec, 0 invented     79.7% prec, 5 invented, 10 corrupt
#   people names      F1 0.938                    F1 0.920
#   speed on those    2.3-4.2x faster            baseline
#   scope nulls       2 (permanent)              0  <-- nemotron keeps these
#   merge adjudication "review" on a true dupe   "merge" (correct)
#   merge draft       drops 3 of 4 records        100/99/100/99% retention
#
# A scope null is stamped with scopeCheckedSig and never revisited, so it is
# permanent data loss rather than a retry. That asymmetry is the whole reason
# extraction and judgement are split: the extraction errors are recoverable
# (re-running the extractor is cheap) and the judgement ones are not.
#
# MEM_EXTRACT_MODEL defaults to LLM_QUERY_MODEL, so leaving it unset keeps the
# old single-model behaviour exactly.
LLM_QUERY_MODEL=nemotron-3-nano:4b
MEM_EXTRACT_MODEL=granite3.3:2b
MEM_SCOPE_MODEL=nemotron-3-nano:4b
MEM_MERGE_MODEL=nemotron-3-nano:4b
# Embedding retries. A save aborts before it writes anything, so an embedding
# failure never leaves a half-written record — but a busy Ollama can still drop
# a request. Transient HTTP statuses (408/409/429/500/502/503/504) are retried
# on both the legacy /api/embeddings and the modern /api/embed route.
MEM_EMBED_RETRIES=2
MEM_EMBED_RETRY_BACKOFF=1.5

# Character budget per embedding. Ollama serves embedding models with a smaller
# context than the model advertises, so a long fact or diary entry can exceed it
# and Ollama answers that with HTTP 500. Text over the budget is truncated
# (head and tail kept); if Ollama still complains the input is halved and retried.
# 8000 is measured, not guessed: the production embedder refused 11189 chars and
# accepted 6000, which is a ~2048-token window. Raise it if your model has the
# room, lower it if you see length errors. Chunk parts are sized against the
# same number, so changing it re-sizes long records too.
MEM_EMBED_MAX_CHARS=8000

# Timeouts for the Ollama *chat* call (query LLM). These are separate from
# MEM_EMBED_* because chat is the one request whose wall-clock time is genuinely
# unbounded: it scales with the prompt and the model runs on CPU when there is no
# GPU. The read budget was hardcoded to 60s, which silently cut off background
# passes -- production measured a 4420-char prompt taking 46s on qwen3.5:2b.
# 300s is the background budget (scope classification, keyword/people extraction,
# merge drafts, the people-candidate resolver). Raise it if a long entry still
# times out; lower MEM_SCOPE_TEXT_WINDOW / MEM_PEOPLE_WINDOW if the model is too
# slow to keep up with them.
MEM_LLM_TIMEOUT=300
# Connect budget is kept short and independent so a genuinely dead Ollama fails
# fast instead of burning the whole read budget first.
MEM_LLM_CONNECT_TIMEOUT=10
# The search-query rewrite sits between the user and their results, so it keeps a
# short budget: a rewrite that takes two minutes is worse than none, because the
# raw query is already good enough to search with.
MEM_SEARCH_LLM_TIMEOUT=45

# How much of each prompt and answer is written to the chat log line. Until this
# existed the log held only the character *counts*, so a wrong reclassify could
# not be investigated without reproducing the call to see what the model had
# actually been shown. Truncated at 1K per field and newlines are escaped, so
# one call stays one line. NOTE: this writes entry and meeting text into
# memory-vault.log, so set it to 0 if that is content you would not want at rest.
MEM_LLM_LOG_CHARS=1000

# Cache for the search-query rewrite. The rewrite is one LLM call per search
# (tens of seconds on a host doing CPU inference) and its answer depends only
# on the query, the active filters and the expand flag -- never on what is in
# the vault -- so repeating a search used to re-ask a settled question and get
# a slightly different answer. Only a real answer is cached; a timeout falls
# back to a heuristic and is deliberately NOT stored, because pinning a
# degraded result for the TTL would turn one slow call into a permanently
# worse search. Set either to 0 to disable the cache entirely.
MEM_QUERY_CACHE_TTL=900
MEM_QUERY_CACHE_MAX=256

# Server status widget. One poller for the whole process feeds every browser
# over SSE (/api/status/stream), and it only pushes when the fingerprint
# changes -- a quiet vault produces no traffic at all. The interval is how
# quickly a newly loaded model shows up, not a page-refresh rate.
MEM_STATUS_POLL_SECONDS=10
# Budget for the three status GETs (/api/version, /api/ps, /api/tags). Kept
# short and separate from the chat and embedding budgets: a status probe must
# never be the reason anything else is slow, and a wedged Ollama should show up
# as "down" rather than as a widget frozen on its last answer.
MEM_STATUS_HTTP_TIMEOUT=8

# Merge-draft budget. The dashboard's merge draft is the one LLM call that sends
# the full text of every selected record in a single uncapped prompt, so it is
# sized against the model's context window rather than against a window.
#
# There is deliberately no output-budget knob. The budget is whatever the
# context has left after the prompt, because the answer scales with the
# selection: measured on real facts, nemotron-3-nano:4b spends 2,776 output
# tokens on a 4-record draft and 5,657 on 12. A fixed budget is therefore either
# too small for the largest allowed cluster -- it truncates mid-JSON, the parse
# finds nothing, and an over-budget request surfaces as a 502 -- or wastefully
# large for the smallest. (900 was the first version of this bug, 4000 the
# second: both sized from a 4-record run.)
#
# MIN_NUM_PREDICT is the floor under which a selection is refused with a 400
# instead of attempted. It buys no extra budget; below it nothing can finish.
# Set it below 2,776 only if you have measured your own drafts to be smaller.
# CONTEXT_TOKENS must track OLLAMA_CONTEXT_LENGTH on the ollama service.
# MAX_CLUSTER is measured, not guessed: at 12 records the prompt is 8,801 tokens,
# leaving 7,531 to write with against a measured 5,657, so the largest allowed
# selection completes. 18 records would leave 4,165 against a larger answer.
MEM_MERGE_MIN_NUM_PREDICT=3000
MEM_MERGE_CONTEXT_TOKENS=16332
MEM_MERGE_MAX_CLUSTER=12

# Long records. A fact or diary entry longer than MEM_CHUNK_CHARS is stored as
# several vector points instead of one, so a query about a detail in the middle
# of it can actually match. See AGENTS.md "Long Records & Chunking".
MEM_CHUNK_CHARS=3000
# Upper bound on embedding calls per save. This is a cost budget, not a
# coverage limit — the splitter widens its chunks rather than drop the tail.
MEM_CHUNK_MAX=16
MEM_CHUNK_OVERLAP=200
# Search over-fetches by this factor so chunk families can collapse to one hit.
MEM_CHUNK_FETCH_MULTIPLIER=3
# Startup re-chunking of records stored before chunking existed. Runs as a
# background task, not a blocking startup step. RECHUNK_LIMIT bounds the work
# per boot; anything left over is picked up by the next restart.
MEM_RECHUNK_ENABLED=1
MEM_RECHUNK_LIMIT=200
MEM_RECHUNK_CONCURRENCY=2

# Graph. Caps the records in one graph response. Over the cap the most
# connected records are kept, and the panel says it was capped rather than
# silently drawing part of the graph. See AGENTS.md "Build Graph Mode".
MEM_GRAPH_MAX_NODES=600

# Logging (DEBUG, INFO, WARNING, ERROR, or CRITICAL)
LOG_LEVEL=INFO
LOG_DIR=./logs

# Timeouts
HTTPX_TIMEOUT=600.0
BASE_URL=https://your-server.com/mem-mcp

# ---------------------------------------------------------------------------
# Sessions and MCP access keys
# ---------------------------------------------------------------------------
# Where the session database lives. Sessions are stored server-side (SQLite),
# so this directory is what makes a logged-in user survive a container rebuild:
# point it at the bind mount ./mem-mcp-data/sessions and the container can be
# replaced without logging anyone out.
# Defaults to <dirname of LOG_DIR>/sessions, i.e. /app/sessions in Docker.
# MEM_SESSION_DIR=/app/sessions
# Add `Secure` to the session cookie. Only turn this on when the app is reached
# over HTTPS *from the browser* — it cannot detect the proxy's scheme, and with
# it on the cookie is dropped entirely on a plain-HTTP visit, which looks like a
# login that does not stick.
MEM_SESSION_SECURE=0

# No longer used to sign the session cookie (the cookie holds only an opaque
# random id now, and sessions live in the database above). Still read at startup,
# so leaving it set costs nothing and removing it is safe either way.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEM_SESSION_SECRET=replace_with_a_stable_random_hex_string

# ---------------------------------------------------------------------------
# Self-service registration
# ---------------------------------------------------------------------------
# Off by default, and it should stay off unless you want strangers creating
# accounts: this opens two unauthenticated POST endpoints that create a vault
# each. They are throttled per client address (10 attempts / 10 minutes) but that
# is an in-process counter — it stops a script, not a botnet, so put a real rate
# limit in your proxy if you turn this on.
#
# When on, the landing page grows a "Create an account" form:
#   * email + password — always available while this is on. The address becomes
#     the account name, so it is NOT verified: anyone can register an address
#     they do not own.
#   * Google ID token — additionally requires a client id saved under
#     Setup → Google sign-in. With no client id configured the Google form is not
#     shown and the endpoint 404s, because a token cannot be checked for audience
#     without one.
#
# Registered passwords live in the session database, not in htpasswd. The
# htpasswd file is mounted read-only precisely so the app cannot rewrite a file
# an operator also edits by hand; login checks the database first and falls back
# to htpasswd, so existing accounts are unaffected.
MEM_REGISTRATION_ENABLED=0

# Daily savepoints (Setup → Maintenance → Backup & Restore)
# MEM_BACKUP_ENABLED=0 disables the scheduled run; manual backups still work.
MEM_BACKUP_ENABLED=1
# Local server time. A restart after the slot waits for the next day.
MEM_BACKUP_HOUR=3
MEM_BACKUP_MINUTES=0
# How many completed savepoints to keep. Older ones are pruned automatically.
MEM_BACKUP_KEEP=14
# Defaults to <dirname of LOG_DIR>/backup, i.e. ./backup locally and /app/backup
# in Docker (where the compose file mounts ./mem-mcp-data/backup there).
# MEM_BACKUP_DIR=./backup

# Diary people extraction. Name extraction runs per window over the whole
# entry, so a long diary entry costs one LLM call per window.
MEM_PEOPLE_WINDOW=6000
# Overlap between windows, so a name straddling a boundary is not cut in half
# and lost by both halves.
MEM_PEOPLE_OVERLAP=600

# Scope reclassification. Both the scope classifier and its people extractor
# read the whole item the same way, per window, so a long diary entry costs one
# LLM call per window. These are separate from MEM_PEOPLE_* above on purpose:
# that pair is the diary *save* path, this pair is the reclassify path.
MEM_SCOPE_TEXT_WINDOW=6000
MEM_SCOPE_TEXT_OVERLAP=600

# People-candidate resolution during reclassification. Separate from
# MEM_SCOPE_TEXT_* above: that pair is the scope *classifier*, this pair is the
# resolver that binds an extracted name to a People record. It gates
# confidence, so a binding made from a fragment of the entry is a wrong edge
# rather than a missed one.
MEM_PEOPLE_RESOLVE_WINDOW=6000
MEM_PEOPLE_RESOLVE_OVERLAP=600

# Diary keyword extraction. Like the people extractor above, it runs per window
# over the whole entry -- it used to send text[:1500], so on a long entry the
# keywords described only its opening.
MEM_KEYWORD_WINDOW=8000
MEM_KEYWORD_OVERLAP=500
# Cap on the union of all windows' keywords. Keywords are a search *boost* (any
# match adds a fixed amount, then stops), so a longer list widens recall and
# slightly widens what can spuriously match. Bounded because the list is
# duplicated onto every chunk of the entry in the Qdrant payload.
MEM_KEYWORD_LIMIT=20

