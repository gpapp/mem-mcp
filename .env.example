# Neo4j Configuration
MEM_NEO4J_PASSWORD=your_secure_password_here
NEO_PASS=your_secure_password_here

# Vector Store (Qdrant)
MEM_QDRANT_URL=http://qdrant:6333

# LLM / Embedder (Ollama)
MEM_LLM_URL=http://ollama:11434
MEM_EMBEDDER_URL=http://ollama:11434
MEM_EMBEDDER_MODEL=nomic-embed-text

# Timeouts
HTTPX_TIMEOUT=600.0
BASE_URL=https://your-server.com/mem-mcp

# Session secret — must be a fixed stable string so sessions survive server restarts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEM_SESSION_SECRET=replace_with_a_stable_random_hex_string
